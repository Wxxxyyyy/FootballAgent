[Unit]
Description=FootballAgent Prediction API (port 8000)
Documentation=https://github.com/Wxxxyyyy/FootballAgent
# 依赖容器服务(MySQL/Neo4j/OpenClaw)，docker 起来后再启动
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/data/workspace/FootballAgent
Environment=PREDICTOR_PORT=8000
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m api.prediction_api
# 崩溃/被杀后 5 秒自动拉起
Restart=always
RestartSec=5
# 防止启动风暴: 60秒内最多重启10次
StartLimitIntervalSec=60
StartLimitBurst=10
LimitNOFILE=65536
StandardOutput=append:/data/workspace/FootballAgent/logs/prediction_api.log
StandardError=append:/data/workspace/FootballAgent/logs/prediction_api.log

[Install]
WantedBy=multi-user.target
